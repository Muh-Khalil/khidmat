# Server config
PORT=5000

# Optional: comma-separated CORS allowlist (e.g. https://app.example.com,https://admin.example.com).
# Leave unset to allow all origins.
# CORS_ORIGINS=

# Timezone — product is Pakistan-only, booking times computed in PKT.
# Setting this here means schedule math is correct regardless of host OS default.
TZ=Asia/Karachi

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Required outside tests. Use a random secret of at least 32 characters.
AUTH_SECRET=

# Production phone verification (Twilio Verify v2). In development, code 1234 is used.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GOOGLE_PLACES_API_KEY=
